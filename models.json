  {
   "key": "veo3",
   "name": "Veo 3",
   "kind": "video",
   "blurb": "Google's top model. Real speech, sound and lip sync in one pass. Best for UGC-style talking clips. 8 seconds.",
   "create": {
    "path": "/api/v1/veo/generate",
    "bodyStyle": "flat"
   },
   "poll": "custom",
   "pollPath": "/api/v1/veo/record-info?taskId={taskId}",
   "params": [
    {
     "name": "prompt",
     "label": "Prompt",
     "type": "string",
     "control": "prompt",
     "required": true,
     "max": 2000,
     "desc": "Describe the shot, the person, and put any spoken lines in quotes."
    },
    {
     "name": "model",
     "label": "Quality",
     "type": "string",
     "control": "seg",
     "enum": [
      "veo3_fast",
      "veo3"
     ],
     "enumLabels": [
      "Fast",
      "Quality"
     ],
     "default": "veo3_fast"
    },
    {
     "name": "imageUrls",
     "label": "Start frame",
     "type": "string",
     "media": "image",
     "multiple": true,
     "maxItems": 2,
     "desc": "Optional. One image: the video grows from it. Two images: first is the start, second is the end."
    },
    {
     "name": "aspectRatio",
     "label": "Shape",
     "type": "string",
     "control": "seg",
     "enum": [
      "9:16",
      "16:9",
      "Auto"
     ],
     "default": "9:16"
    },
    {
     "name": "enableTranslation",
     "label": "Translate prompt to English",
     "type": "boolean",
     "default": true,
     "advanced": true
    },
    {
     "name": "enableFallback",
     "label": "Retry on another model if blocked",
     "type": "boolean",
     "default": false,
     "advanced": true,
     "desc": "Helps when a prompt trips the content filter."
    },
    {
     "name": "seeds",
     "label": "Seed",
     "type": "integer",
     "min": 10000,
     "max": 99999,
     "advanced": true,
     "desc": "Same seed + same settings gives a similar result."
    },
    {
     "name": "watermark",
     "label": "Watermark text",
     "type": "string",
     "advanced": true
    }
   ],
   "cost": {
    "type": "flat",
    "by": [
     "model"
    ],
    "rates": {
     "veo3_fast": 60,
     "veo3": 250
    }
   }
  },
  {
   "key": "kling3",
