     "max": 5000,
     "desc": "For dialogue use [Name, voice style]: \"line\"."
    },
    {
     "name": "image_urls",
     "label": "Start / end frame",
     "type": "string",
     "media": "image",
     "multiple": true,
     "maxItems": 2,
