    {
     "name": "duration",
     "label": "Length",
     "type": "string",
     "control": "slider",
     "min": 3,
     "max": 15,
     "step": 1,
     "default": "5",
     "unit": "s"
    },
    {
     "name": "aspect_ratio",
     "label": "Shape",
     "type": "string",
     "control": "seg",
     "enum": [
      "9:16",
      "16:9",
      "1:1"
     ],
     "default": "9:16"
    },
    {
     "name": "mode",
     "label": "Quality",
     "type": "string",
     "control": "seg",
     "enum": [
      "std",
      "pro"
     ],
     "enumLabels": [
      "Standard 720p",
      "Pro 1080p"
     ],
     "default": "std"
    },
    {
     "name": "sound",
     "label": "Generate sound",
     "type": "boolean",
     "default": false,
     "desc": "Native audio. Costs more."
    }
   ],
   "cost": {
    "type": "per_second",
    "sec": "duration",
    "by": [
     "mode",
     "sound"
    ],
    "rates": {
     "std|false": 14,
     "std|true": 20,
     "pro|false": 18,
     "pro|true": 27
    }
   }
  },
